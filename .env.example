# Copy this file to .env (same folder) and fill it in. .env is never committed or deployed.
# Without a .env, the site runs with the local development defaults (root/root, and the
# admin password hash written in login.php).

# --- live server only (docker-compose.prod.yml) ---
# the domain the site will live at; Caddy gets its HTTPS certificate for this name
SITE_DOMAIN=thrysus.example.com

# --- database ---
# a dedicated user for the site (NOT root). created automatically the first time the
# database starts with an empty volume, so set these before the first launch on the server.
DB_USER=thrysus
DB_PASSWORD=change-me-to-a-long-random-password
DB_ROOT_PASSWORD=change-me-to-a-different-long-random-password

# --- admin login ---
# a bcrypt hash of your admin password (not the password itself). make one with:
#   docker compose exec web php -r "echo password_hash('your-password', PASSWORD_DEFAULT);"
# then paste it below inside SINGLE quotes, because the hash contains $ signs.
ADMIN_PASSWORD_HASH='$2y$10$replace-this-with-your-own-hash'
